<?xml version="1.0" encoding="UTF-8"?>
<!DOCTYPE plist PUBLIC "-//Apple//DTD PLIST 1.0//EN" "http://www.apple.com/DTDs/PropertyList-1.0.dtd">
<plist version="1.0">
<dict>
    <key>method</key>
    <string>app-store-connect</string>
    <!-- TODO: replace with your real Apple Developer Team ID (Account > Membership) -->
    <key>teamID</key>
    <string>REPLACE_WITH_TEAM_ID</string>
    <key>signingStyle</key>
    <string>manual</string>
    <key>provisioningProfiles</key>
    <dict>
        <!-- TODO: value must match the exact name you gave the provisioning
             profile in the Apple Developer portal, e.g. "BlobRush AppStore" -->
        <key>com.ultimastella.blobrush</key>
        <string>REPLACE_WITH_PROVISIONING_PROFILE_NAME</string>
    </dict>
</dict>
</plist>
