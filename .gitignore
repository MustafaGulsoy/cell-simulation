# Unity generated
/[Ll]ibrary/
/[Tt]emp/
/[Oo]bj/
/[Bb]uild/
/[Bb]uilds/
/[Ll]ogs/
/[Uu]ser[Ss]ettings/
/.utmp/
/[Aa]ssets/_Recovery/
/[Aa]ssets/_Recovery.meta

# MemoryCaptures
/[Mm]emoryCaptures/

# Asset meta data should only be ignored when the corresponding asset is also ignored
!/[Aa]ssets/**/*.meta

# Autogenerated Jetbrains Rider plugin
/[Aa]ssets/Plugins/Editor/JetBrains*

# Visual Studio / Rider cache
.vs/
.idea/

# Autogenerated VS/MD/Consulo solution and project files
# (Server/ is a real hand-written .NET project, not Unity-generated - keep its .csproj/.sln)
ExportedObj/
.consulo/
*.csproj
*.unityproj
*.sln
!Server/**/*.csproj
!Server/**/*.sln
*.suo
*.tmp
*.user
*.userprefs
*.pidb
*.booproj
*.svd
*.pdb
*.mdb
*.opendb
*.VC.db

# Unity3D generated meta files
*.pidb.meta
*.pdb.meta
*.mdb.meta

# Unity3D generated crash reports
sysinfo.txt

# Packed builds
*.apk
*.aab
*.unitypackage
*.app
*.ipa

# Crashlytics generated file
crashlytics-build.properties

# .NET server subproject build artifacts
**/bin/
**/obj/

# Unity crash-recovery autosave - the meta re-include rule above would otherwise catch this
/[Aa]ssets/_Recovery.meta
